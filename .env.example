# Puerto API compatible con Firecrawl v1/v2 (n8n, LangChain, LlamaIndex, etc.)
PORT=3002

# URL y puerto del motor Go (HTTP/2 + TLS + DOM cleaner + Markdown + Buscador)
GO_ENGINE_URL=http://127.0.0.1:8081
GO_ENGINE_PORT=8081
ENV=production

# API Key opcional para /extract, /agent y scrape formats=["extract"] (NVIDIA NIM u OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/nemotron-3-nano-30b

# Seguridad opcional (cambiar ENFORCE_AUTH=true para exigir Bearer TEST_API_KEY)
ENFORCE_AUTH=false
TEST_API_KEY=
